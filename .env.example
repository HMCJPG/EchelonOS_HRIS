# --- Database ---
# Neon pooled connection string (Dashboard -> Connect -> "Pooled connection").
# Leave unset for local dev: the app falls back to an embedded PGlite Postgres in ./.pglite
DATABASE_URL=

# --- WorkOS AuthKit ---
# From the WorkOS dashboard (https://dashboard.workos.com). If WORKOS_API_KEY is
# unset the app runs in dev-auth mode: a local login page that lets you pick a
# role. Never set DEV_AUTH_ALLOW in production.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Must match a Redirect URI configured in WorkOS (e.g. http://localhost:3000/callback)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# openssl rand -base64 32  (session cookie encryption)
WORKOS_COOKIE_PASSWORD=
